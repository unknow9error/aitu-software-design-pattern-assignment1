@startuml
title Study Report Builder
skinparam classAttributeIconSize 0
hide empty members

class Report <<Product>> {
  - title: String
  - content: String
  + Report(title: String, content: String)
  + getTitle(): String
  + getContent(): String
}
abstract class ReportBuilder <<Builder>> {
  - title: String
  - sections: String
  + setTitle(title: String): ReportBuilder
  + addSection(heading: String, text: String): ReportBuilder
  + build(): Report
  - checkText(text: String, field: String): void
  # {abstract} formatSection(heading: String, text: String): String
  # {abstract} formatReport(title: String, sections: String): String
}
class PlainTextReportBuilder <<ConcreteBuilder>> {
  # formatSection(heading: String, text: String): String
  # formatReport(title: String, sections: String): String
}
class HtmlReportBuilder <<ConcreteBuilder>> {
  # formatSection(heading: String, text: String): String
  # formatReport(title: String, sections: String): String
}
class ReportDirector <<Director>> {
  + createStudyReport(builder: ReportBuilder): Report
}
class Main <<Client>> {
  + {static} main(args: String[]): void
}

ReportBuilder <|-- PlainTextReportBuilder
ReportBuilder <|-- HtmlReportBuilder
ReportBuilder ..> Report : creates
ReportDirector ..> ReportBuilder : calls steps
Main ..> ReportDirector : calls
Main ..> PlainTextReportBuilder : creates
Main ..> HtmlReportBuilder : creates
Main ..> Report : prints
@enduml
